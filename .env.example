# Supabase 프로젝트 설정 > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# 웹 푸시 (npx web-push generate-vapid-keys 로 생성)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것): 알림 대상 계산과 발송 기록에 사용
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Weekly summary email (Friday 17:00 KST)
WEEKLY_EMAIL_ENABLED=false
GMAIL_USER=sender@example.com
GMAIL_APP_PASSWORD=your-google-app-password

# Server-only automatic report translation (same provider as Cell Care)
TRANSLATION_ENABLED=false
ANTHROPIC_API_KEY=your-anthropic-api-key
TRANSLATE_MODEL=your-translation-model
